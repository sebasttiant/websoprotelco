# ==============================================================================
# SOPROTELCO — Isolated staging environment
#
# Copy to `.env.staging` ON THE HOST and fill in real values. Run staging with:
#
#   docker compose --env-file .env.staging up -d proxy
#
# Isolation comes from COMPOSE_PROJECT_NAME. Compose prefixes every volume,
# network and container with the project name, so a distinct project cannot read
# or write production state even though it uses the same compose.yaml. Ports are
# the one resource Compose does NOT namespace, so they are set explicitly here.
#
# `bash tests/deploy/staging-isolation.sh` asserts these guarantees locally,
# without contacting any VPS.
# ==============================================================================

# --- Isolation ------------------------------------------------------------
# MUST differ from production ("websoprotelco"). This is what separates
# volumes, networks and container names.
COMPOSE_PROJECT_NAME=websoprotelco-staging

# --- PostgreSQL -----------------------------------------------------------
# A separate database in a separate volume. Never point staging at the
# production database: the deploy path drops and recreates it during rollback.
POSTGRES_DB=websoprotelco_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
# Non-production port. Production uses 5432.
POSTGRES_PORT=15432

DATABASE_URL=postgresql://staging_user:CHANGE_ME_STAGING_DB_PASSWORD@127.0.0.1:15432/websoprotelco_staging
DATABASE_POOL_MAX=5
DATABASE_SSL=disable

# --- Storage --------------------------------------------------------------
STORAGE_PROVIDER=local

# --- Web server -----------------------------------------------------------
# Loopback only. Staging must not be publicly reachable; reach it over an SSH
# tunnel rather than by opening a firewall port.
WEB_HOST=127.0.0.1
# Non-production port. Production uses 8686, the disposable Compose smoke uses 8687.
WEB_PORT=8688

# --- Observability --------------------------------------------------------
RELEASE_SHA=unknown
OBSERVABILITY_ENVIRONMENT=staging
# Must still be a valid https URL: the production preflight rejects anything
# else. Point it at a staging channel, never at the production on-call webhook.
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_LATENCY_SECONDS=1
OBSERVABILITY_LATENCY_MINIMUM_SAMPLES=10
OBSERVABILITY_READINESS_FAILURES=3
OBSERVABILITY_ALERT_TIMEOUT_MS=10000

# --- Seeds ----------------------------------------------------------------
# Left unset on purpose: db/seeds/001-users.ts refuses to run outside local
# development, and staging must not carry the development accounts.
