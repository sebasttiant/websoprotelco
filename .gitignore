# Dependencies
node_modules/

# Build outputs
.next/
# Disposable project root built by scripts/typecheck.mjs so `next typegen` never
# writes into the repository root. It is removed at the end of every run; ignoring
# it keeps a crashed run from leaving the tree dirty.
.next-typecheck/
out/
dist/
build/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local/generated AI registry artifacts
.atl/
.codegraph/

# Runtime image uploads written by the storage adapter
public/uploads/*
!public/uploads/.gitkeep

# OS/editor
.DS_Store
.idea/
.vscode/

# Temporary archives and local backups
*.tar.gz
*.zip
*.bak

# Deploy backups, dumps and rollback manifest written on the server.
# These MUST stay ignored: rollback.sh refuses to run on a dirty tree, so an
# untracked backup directory would permanently block rollback.
backups/
