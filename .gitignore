# Dependencies
node_modules/

# Build outputs
.next/
out/
# Disposable Next project root used by `pnpm typecheck` to keep `next typegen` from writing
# generated files (notably `next-env.d.ts`) into the repository root. Normally removed by the
# script itself; stays ignored so an interrupted run cannot dirty the tree.
.next-typecheck/
dist/
build/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
!.env.staging.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local/generated AI registry artifacts
.atl/
.codegraph/

# Runtime image uploads written by the storage adapter
public/uploads/*
!public/uploads/.gitkeep

# OS/editor
.DS_Store
.idea/
.vscode/

# Temporary archives and local backups
*.tar.gz
*.zip
*.bak

# Deploy backups, dumps and rollback manifest written on the server.
# These MUST stay ignored: rollback.sh refuses to run on a dirty tree, so an
# untracked backup directory would permanently block rollback.
backups/

# Shared deploy/rollback flock file. It must not make the scripts reject their own lock.
.deploy.lock
