    "test:contract:assets": "node tests/deploy/runtime-assets-contract.mjs",
    "test:db:reset": "tsx tests/helpers/reset-database.ts",
    "test:db:seed": "tsx tests/helpers/seed-database.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
