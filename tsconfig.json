{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2024"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@tests/*": [
        "tests/*"
      ]
    }
  },
  "include": [
    "next-typecheck-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "vitest.config.ts",
    "playwright.config.ts",
    // Generated route types come from the disposable typecheck root built by
    // scripts/typecheck.mjs. This is the only copy the program may see: `routes.d.ts` declares
    // global type aliases, so pulling in a second copy from `.next` would raise duplicate
    // identifier errors.
    ".next-typecheck/.next/types/**/*.ts",
    // Kept only to satisfy `next build`/`next dev`, which rewrite this file when these entries
    // are missing. `exclude` below neutralises them, so build and dev output never reaches the
    // typecheck program.
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Regenerated by `next typegen` with the active `distDir` baked in; next-typecheck-env.d.ts
    // carries the same ambient references without changing between runs.
    "next-env.d.ts",
    // Excludes both stale build output and a concurrently running dev server's transient,
    // possibly half-written validator bytes. `exclude` wins over `include`.
    ".next"
  ]
}
